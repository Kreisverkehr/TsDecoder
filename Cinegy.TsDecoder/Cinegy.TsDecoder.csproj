<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>4.0.0-alpha</Version>
		<PackageId>Kreisverkehr.TsDecoder</PackageId>
		<Authors>Lewis Kirkaldie; Kreisverkehr</Authors>
		<Company>Kreisverkehr</Company>
		<Description>Unofficial fork of Cinegy.TsDecoder, an MPEG2 Transport Stream decoder for .NET 10.</Description>
		<Copyright>Cinegy GmbH</Copyright>
		<PackageTags>Transport Stream MPEGTS unofficial fork Kreisverkehr</PackageTags>
		<PackageProjectUrl>https://github.com/Kreisverkehr/TsDecoder</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Kreisverkehr/TsDecoder</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<NeutralLanguage />
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>


</Project>
